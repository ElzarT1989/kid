# Окружение: development | production
ENVIRONMENT=development

# Postgres 16 (для локального запуска можно использовать SQLite:
# sqlite+aiosqlite:///./kidsedu.db)
DATABASE_URL=postgresql+asyncpg://kidsedu:kidsedu@postgres:5432/kidsedu

# Telegram Bot API токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Google Gemini API ключ (aistudio.google.com) — нужен с Этапа 2
GEMINI_API_KEY=

# Пути хранения (внутри контейнера)
VIDEO_STORAGE_PATH=/app/storage/videos
TTS_CACHE_PATH=/app/storage/tts_cache

# Интервал фонового парсинга каналов, часы
INGESTOR_INTERVAL_HOURS=12

# URL backend API, который будет вшит в сборку frontend PWA (Vite build-time
# переменная — для смены адреса после сборки нужен пересбор образа)
VITE_API_BASE_URL=http://localhost:8000
